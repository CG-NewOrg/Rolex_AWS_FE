<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:layout="sap.ui.layout"
>
    <Dialog
        id="viewDocumentDialog"
        resizable="false"
        contentWidth="80%"
        contentHeight="80%"
        title="{i18n>preview}"
        verticalScrolling="false"
    >
        <VBox class="sapUiSmallMarginTopBottom" width="100%" height="100%">
            <Label text="{fileViewModel>/Name}" class="sapUiTinyMarginBottom" />
            
            <TextArea
                value="{appmodel>/BSContent}"
                visible="{path: 'appmodel>/BSContent', formatter: '.formatter.isTextContent'}"
                maxLength="0"
                growing="false"
                wrapping="Soft"
                editable="false"
                width="100%"
                height="100%"
                valueLiveUpdate="false"
                change=".onBSFileContentAreaChange"
                class="noHorizontalScrollTextArea"
            >
                <layoutData>
                    <FlexItemData growFactor="1" shrinkFactor="0" baseSize="0" />
                </layoutData>
            </TextArea>

            <PDFViewer
                width="100%"
                height="500px"
                source="{fileViewModel>/srcUrl}"
                isTrustedSource="true"
                visible="false"
                
            />
            <Image
                id="imagepreview" 
                src="{fileViewModel>/srcUrl}"
                visible="{path: 'fileViewModel>/srcUrl', formatter: '.formatter.isImageContent'}"
                class="image-max-size"
                
            />
        </VBox>
        <footer>
            <Toolbar>
                <ToolbarSpacer />
                <Button
                    press=".closeSysKeyFr"
                    text="{i18n>close}"
                />
            </Toolbar>
        </footer>
    </Dialog>
</core:FragmentDefinition>