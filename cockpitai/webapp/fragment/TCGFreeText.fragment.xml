<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:layout="sap.ui.layout"
 >
  <Dialog  resizable="false"
    stretch="false"
        contentWidth="70%" title="{i18n>freeText}">  
  <VBox >
        <TextArea
            value="{tcgModel>/fText}"
                            class="sapUiTinyMargin"
            width="100%"
            height="100%"
                            growing="true"
            editable="true"
        />

    </VBox>
    <footer>
   
        <Toolbar>
            <ToolbarSpacer/>
     <Button press=".saveTcgFreeText" enabled="true" text="{i18n>save}"/>
     <Button press=".closeSysKeyFr" text="{i18n>cancel}"/>
        </Toolbar>
   
    </footer>

</Dialog>
</core:FragmentDefinition>