<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:layout="sap.ui.layout"
>
    <Dialog
        resizable="true"
        stretch="false"
        contentWidth="83%"
        contentHeight="calc(60vh + 2rem)"
        title="{i18n>msgDesc}"
        verticalScrolling="false"
    >
        <VBox class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop">
            <TextArea
                growing="false"
                wrapping="None"
                value="{expModel>/exTxt}"
                width="100%"
                height="60vh"
                editable="false"
            />
        </VBox>
        <footer>
            <Toolbar>
                <ToolbarSpacer />
                <Button
                    press=".closeSysKeyFr"
                    text="{i18n>close}"
                />
            </Toolbar>
        </footer>
    </Dialog>
</core:FragmentDefinition>
