<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:layout="sap.ui.layout"
>
    <Dialog
        resizable="true"
        stretch="false"
        contentWidth="65%"
        contentHeight="70%"
        title="{i18n>history}"
        verticalScrolling="true"
    >
        <VBox class="sapUiTinyMargin">
            <List items="{histM>/historyData}" showSeparators="None" backgroundDesign="Transparent">
                <items>
                    <CustomListItem>
                        <VBox class="sapUiSmallMargin">
                            <VBox justifyContent="End" alignItems="End" class="sapUiSmallMarginEnd">
                                <Label text="Prompt:" design="Bold" class="sapUiTinyMarginBottom"/>
                                <Text text="{= ${histM>promptHistory} ? ${histM>promptHistory} : 'No Prompt'}" class="Human sapUiTinyMargin"/>
                            </VBox>
                            <VBox class="sapUiTinyMarginTop">
                                <Label text="AI Response:" design="Bold" class="sapUiTinyMarginBottom"/>
                                <VBox class="AIChatHistory">
                                    <core:HTML
                                        sanitizeContent="false"
                                        content="{ path: 'histM>aiResponseHistory', formatter: '.formatter.mdToHTML' }"
                                    />
                                </VBox>
                            </VBox>
                        </VBox>
                    </CustomListItem>
                </items>
            </List>
        </VBox>
        <footer>
            <Toolbar>
                <ToolbarSpacer />
                <Button
                    press=".closeHistory"
                    text="{i18n>close}"
                />
            </Toolbar>
        </footer>
    </Dialog>
</core:FragmentDefinition>