<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        title="All Feedback"
        contentWidth="900px"
        contentHeight="500px"
        resizable="true"
        draggable="true"
    >
        <content>
            <Table
                id="allFeedbackTable"
                items="{allFeedbackModel>/feedbackList}"
                growing="true"
                growingThreshold="20"
                alternateRowColors="true"
                sticky="ColumnHeaders"
            >
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="Feedback List ({allFeedbackModel>/feedbackCount})" />
                        <ToolbarSpacer />
                        <SearchField
                            placeholder="Search..."
                            liveChange=".onSearchAllFeedback"
                            width="250px"
                        />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column width="8%">
                        <Text text="Issue ID" />
                    </Column>
                    <Column width="15%">
                        <Text text="Title" />
                    </Column>
                    <Column width="22%">
                        <Text text="Detail" />
                    </Column>
                    <Column width="10%">
                        <Text text="Type" />
                    </Column>
                    <Column width="10%">
                        <Text text="Priority" />
                    </Column>
                    <Column width="10%">
                        <Text text="Status" />
                    </Column>
                    <Column width="12%">
                        <Text text="Created By" />
                    </Column>
                    <Column width="13%">
                        <Text text="Created At" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{allFeedbackModel>Issue_ID}" />
                            <Text text="{allFeedbackModel>IssueTitle}" />
                            <Text text="{allFeedbackModel>IssueDetail}" wrapping="true" />
                            <Text text="{allFeedbackModel>IssueType}" />
                            <ObjectStatus
                                text="{allFeedbackModel>Priority}"
                                state="{= ${allFeedbackModel>Priority} === 'High' ? 'Error' : (${allFeedbackModel>Priority} === 'Medium' ? 'Warning' : 'Success')}"
                            />
                            <ObjectStatus
                                text="{allFeedbackModel>IssueStatus}"
                                state="{= ${allFeedbackModel>IssueStatus} === 'Open' ? 'Warning' : (${allFeedbackModel>IssueStatus} === 'Closed' ? 'Success' : 'Information')}"
                            />
                            <Text text="{allFeedbackModel>CreatedBy}" />
                            <Text text="{allFeedbackModel>CreatedAt}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        <beginButton>
            <Button
                text="Refresh"
                icon="sap-icon://refresh"
                press=".onRefreshAllFeedback"
                type="Emphasized"
            />
        </beginButton>
        <endButton>
            <Button
                text="Close"
                press=".onCloseViewAllFeedback"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>