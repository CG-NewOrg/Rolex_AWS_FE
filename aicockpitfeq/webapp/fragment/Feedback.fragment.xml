<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified"
    xmlns:l="sap.ui.layout"
    xmlns:fr="sap.ui.layout.form"
    xmlns:layout="sap.ui.layout"
>
    <Dialog
        resizable="true"
        title="{i18n>fbTitle}"
    >
        <VBox class="sapUiSmallMargin">
            <Label text="{i18n>subtitle}" />
            <fr:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout"
                title=""
                labelSpanXL="4"
                labelSpanL="4"
                labelSpanM="12"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="0"
                emptySpanL="0"
                emptySpanM="0"
                emptySpanS="0"
                columnsXL="2"
                columnsL="1"
                columnsM="1"
                singleContainerFullSize="false"
            >
                <fr:content>
                    <Label text="{i18n>issueType}" />
                    <Select
                        width="100%"
                        selectedKey="{appmodel>/feedbackForm/issueType}"
                        change=".selIssueTypeFB"
                    >
                        <items>
                            <core:Item
                                key="Technical"
                                text="Technical"
                            />
                            <core:Item
                                key="Basis"
                                text="Basis"
                            />
                            <core:Item
                                key="Other"
                                text="Other"
                            />
                        </items>
                        <layoutData>
                            <FlexItemData growFactor="1" />
                        </layoutData>
                    </Select>

                    <Label text="{i18n>priority}" />
                    <Select
                        width="100%"
                        selectedKey="{appmodel>/feedbackForm/priority}"
                        change=".selPriorityFB"
                    >
                        <items>
                            <core:Item
                                key="Low"
                                text="Low"
                            />
                            <core:Item
                                key="Medium"
                                text="Medium"
                            />
                            <core:Item
                                key="High"
                                text="High"
                            />
                        </items>
                        <layoutData>
                            <FlexItemData growFactor="1" />
                        </layoutData>
                    </Select>
                    <Label required="true" text="{i18n>titleT}" />
                    <Input value="{appmodel>/feedbackForm/issueSubject}">
                        <layoutData>
                            <FlexItemData growFactor="1" />
                        </layoutData>
                    </Input>
                    <Label required="true" text="{i18n>desc}" />
                    <TextArea
                        wrapping="Soft"
                        maxLength="200"
                        showExceededText="false"
                        width="100%"
                        value="{appmodel>/feedbackForm/issueDesc}"
                        placeholder="Add your Message here"
                    >
                        <layoutData>
                            <FlexItemData growFactor="1" />
                        </layoutData>
                    </TextArea>
                </fr:content>
            </fr:SimpleForm>
            <HBox>
                <Text text="{i18n>note}" />
                <Link
                    text="'DL IN NA AS SAP - Technical Solution Center'"
                    press=".onPressFeedbackEmail"
                />
                <Text text="{i18n>note2}" />
            </HBox>
        </VBox>
        <footer>
            <Toolbar>
                <ToolbarSpacer />
                <HBox>
                    <Button
                        text="{i18n>save}"
                        press=".onFeedbackSubmit"
                        type="Emphasized"
                        class="sapUiTinyMarginEnd"
                    />
                    <Button
                        press=".closeSysKeyFr"
                        text="{i18n>close}"
                    />
                </HBox>
            </Toolbar>
        </footer>
    </Dialog>
</core:FragmentDefinition>
