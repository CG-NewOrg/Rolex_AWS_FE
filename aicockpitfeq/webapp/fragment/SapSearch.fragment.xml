<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form"
  xmlns:l="sap.ui.layout">

  <Dialog
    id="sapSearchDialog"
    title="Object Selection"
    contentWidth="780px"
    resizable="true"
    draggable="true">

    <VBox class="sapUiSmallMarginTop sapUiSmallMarginBottom" width="100%">
      <!-- Filter bar style: 3 fields side by side -->
      <HBox alignItems="Start" justifyContent="Start" class="sapUiSmallMarginBottom sapUiSmallMarginBegin">
        <VBox class="sapUiSmallMarginEnd">
          <layoutData><FlexItemData growFactor="1"/></layoutData>
          <Label text="Object Type" required="true" class="sapUiTinyMarginBottom"/>
          <Select
            selectedKey="{sapSearchModel>/objectType}"
            width="100%">
            <core:Item key="PROG" text="Program"/>
            <core:Item key="FUGR" text="Function Group"/>
            <core:Item key="FUNC" text="Function Module"/>
            <core:Item key="CLAS" text="Class/Interface"/>
            <core:Item key="INTF" text="Interface"/>
            <core:Item key="TABL" text="Table"/>
            <core:Item key="DDLS" text="CDS View"/>
            <core:Item key="BDEF" text="Behavior Definition"/>
            <core:Item key="SRVD" text="Service Definition"/>
            <core:Item key="SRVB" text="Service Binding"/>
            <core:Item key="DEVC" text="Package"/>
            <core:Item key="INCL" text="Include"/>
            <core:Item key="MSAG" text="Message Class"/>
            <core:Item key="DTEL" text="Data Element"/>
            <core:Item key="DOMA" text="Domain"/>
            <core:Item key="TRAN" text="Transaction"/>
          </Select>
        </VBox>

        <VBox>
          <layoutData><FlexItemData growFactor="2"/></layoutData>
          <Label text="Search Pattern" required="true" class="sapUiTinyMarginBottom"/>
          <SearchField
            id="sapSearchPattern"
            width="90%"
            value="{sapSearchModel>/pattern}"
            placeholder="e.g. Z* or ZABAP_TEST"
            search=".onSapSearchExecute"
            showRefreshButton="false"/>
          <Text
            text="Tip: Use Z* to search all Z-objects of the selected type."
            class="sapUiTinyMarginTop sapSearchTip"/>
        </VBox>
      </HBox>

      <Table
        id="sapSearchResultsTable"
        mode="SingleSelectMaster"
        width="100%"
        items="{sapSearchModel>/results}">

        <headerToolbar>
          <Toolbar>
            <Title text="Results"/>
            <ToolbarSpacer/>
            <Text text="{= (${sapSearchModel>/results}.length || 0) + ' item(s)'}"/>
          </Toolbar>
        </headerToolbar>

        <columns>
          <Column><Text text="Object Type"/></Column>
          <Column><Text text="Name"/></Column>
          <Column><Text text="Description"/></Column>
        </columns>

        <items>
          <ColumnListItem>
            <cells>
              <Text text="{sapSearchModel>type}"/>
              <Text text="{sapSearchModel>name}"/>
              <Text text="{sapSearchModel>desc}"/>
            </cells>
          </ColumnListItem>
        </items>
      </Table>

    </VBox>

    <beginButton>
      <Button text="Use Selected" type="Emphasized" press=".onSapSearchUseSelected"/>
    </beginButton>
    <endButton>
      <Button text="Close" type="Transparent" press=".onSapSearchClose"/>
    </endButton>
  </Dialog>

</core:FragmentDefinition>