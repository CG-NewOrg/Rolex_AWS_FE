<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:layout="sap.ui.layout"
>
    <Dialog
        resizable="false"
        stretch="false"
        contentWidth="83%"
        title="{i18n>msgDesc}"
    >
        <VBox class="sapUiSmallMargin">
            <TextArea
                maxLength="true"
                growing="true"
                wrapping="None"
                value="{expModel>/exTxt}"
                width="100%"
                editable="false"
            />
        </VBox>
        <footer>
            <Toolbar>
                <ToolbarSpacer />
                <Button
                    press=".closeSysKeyFr"
                    text="{i18n>close}"
                />
            </Toolbar>
        </footer>
    </Dialog>
</core:FragmentDefinition>
