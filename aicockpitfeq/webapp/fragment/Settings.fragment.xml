<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified"
	xmlns:l="sap.ui.layout"
	xmlns:f="sap.ui.layout.form"
    xmlns:layout="sap.ui.layout"
	>
	 <Dialog resizable="true" title="{i18n>settings}"> 
     	<VBox class="sapUiSmallMargin">
  		<Title text="Temperature" class="sapUiSmallMarginBegin" />
            <HBox>
                <Slider value="{path:'viewModel>/comnPopUpModelParamTemp', type:'sap.ui.model.type.Float'}"
                        class="sapUiSmallMarginBegin" width="100%" min="0" max="1" step="0.01"
                        showAdvancedTooltip="true" showHandleTooltip="false" inputsAsTooltips="true"
                        change=".onSliderChangeTempartre" />
                <Input type="Number" value="{path:'viewModel>/comnPopUpModelParamTemp', type:'sap.ui.model.type.Float'}"
                       class="sapUiSmallMarginBegin" width="40%" />
            </HBox>
			<Title text="Top Probabilities" class="sapUiSmallMarginBegin" />
            <HBox>
                <Slider value="{path:'viewModel>/comnPopUpModelParamTopP', type:'sap.ui.model.type.Float'}"
                        width="100%" min="0" max="1" step="0.01" showAdvancedTooltip="true"
                        showHandleTooltip="false" inputsAsTooltips="true" class="sapUiSmallMarginBegin"
                        change=".onSliderChangeTopProblity" />
                <Input type="Number" value="{path:'viewModel>/comnPopUpModelParamTopP', type:'sap.ui.model.type.Float'}"
                       class="sapUiSmallMarginBegin" width="40%" />
            </HBox>
 
            <Title text="Max Response (Tokens)" class="sapUiSmallMarginBegin" visible="{= ${appModel>/bAiAssistant} === false}" />
            <HBox visible="{= ${appModel>/bAiAssistant} === false}">
                <Slider value="{path:'viewModel>/comnPopUpModelParamMaxLength', type:'sap.ui.model.type.Integer'}"
                        width="100%" min="0" max="32000" step="1" showAdvancedTooltip="true"
                        showHandleTooltip="false" inputsAsTooltips="true" class="sapUiSmallMarginBegin"
                        change=".onSliderChangeParamMaxLength" />
                <Input type="Number" value="{path:'viewModel>/comnPopUpModelParamMaxLength', type:'sap.ui.model.type.Integer'}"
                       class="sapUiSmallMarginBegin" width="40%" />
            </HBox>
 
            <Title text="Frequency Penalty" class="sapUiSmallMarginBegin" visible="{= ${appModel>/bAiAssistant} === false}" />
            <HBox visible="{= ${appModel>/bAiAssistant} === false}">
                <Slider value="{path:'viewModel>/comnPopUpModelParamFreqP', type:'sap.ui.model.type.Float'}"
                        width="100%" min="0" max="2" step="0.01" showAdvancedTooltip="true"
                        showHandleTooltip="false" inputsAsTooltips="true" class="sapUiSmallMarginBegin"
                        change=".onSliderChangeParamFreqP" />
                <Input type="Number" value="{path:'viewModel>/comnPopUpModelParamFreqP', type:'sap.ui.model.type.Float'}"
                       class="sapUiSmallMarginBegin" width="40%" />
            </HBox>
 
            <Title text="Presence Penalty" class="sapUiSmallMarginBegin" visible="{= ${appModel>/bAiAssistant} === false}" />
            <HBox visible="{= ${appModel>/bAiAssistant} === false}">
                <Slider value="{path:'viewModel>/comnPopUpModelParamPresenceP', type:'sap.ui.model.type.Float'}"
                        width="100%" min="0" max="2" step="0.01" showAdvancedTooltip="true"
                        showHandleTooltip="false" inputsAsTooltips="true" class="sapUiSmallMarginBegin"
                        change=".onSliderChangeParamPresenceP" />
                <Input type="Number" value="{path:'viewModel>/comnPopUpModelParamPresenceP', type:'sap.ui.model.type.Float'}"
                       class="sapUiSmallMarginBegin" width="40%" />
            </HBox>
 
            <Title text="Context History" class="sapUiSmallMarginBegin" visible="{= ${appModel>/bAiAssistant} === false}" />
            <HBox visible="{= ${appModel>/bAiAssistant} === false}">
                <Slider value="{path:'viewModel>/comnPopUpModelParamContextHist', type:'sap.ui.model.type.Integer'}"
                        width="100%" min="2" max="20" step="1" showAdvancedTooltip="true"
                        showHandleTooltip="false" inputsAsTooltips="true" class="sapUiSmallMarginBegin"
                        change=".onSliderChangeParamContextHist" />
                <Input type="Number" value="{path:'viewModel>/comnPopUpModelParamContextHist', type:'sap.ui.model.type.Integer'}"
                       class="sapUiSmallMarginBegin" width="40%" />
            </HBox>
          	</VBox>
        <footer>
				<Toolbar>
					<ToolbarSpacer/>
                    <Button press=".handleSaveParameterPopUp" text="{i18n>save}" type="Emphasized"/>
                    <Button press=".settingsRefresh" text="{i18n>refresh}"/>
					<Button press=".closeSettings" text="{i18n>cancel}"/>
				</Toolbar>
				
			</footer> 
     		 </Dialog>  
</core:FragmentDefinition>