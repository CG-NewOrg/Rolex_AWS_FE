{
  "_version": "1.84.0",
  "sap.app": {
    "id": "aicockpitfeq",
    "type": "application",
     "dataSources": {
      "mainService": {
        "uri": "cockpit/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",

    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.23.0",
      "toolsId": "d09a86d5-c3c4-412e-9827-173798dad72a"
    },
    "crossNavigation": {
      "inbounds": {
        "Zaicockpitsemobj-display": {
          "semanticObject": "Zaicockpitsemobj",
          "action": "display",
          "title": "{{Zaicockpitsemobj-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.147.1",
      "libs": {
        "sap.f": {},
        "sap.m": {},
        "sap.tnt": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.ui.unified": {},
        "sap.suite.ui.commons": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "aicockpitfeq.i18n.i18n"
        }
      },
       "": {
        "dataSource": "mainService",
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      }
    },
    "resourceRoots": {
      "aicockpitfeq.lib": "./lib"
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "flexibleColumnLayout",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "aicockpitfeq.view",
        "async": true
      },
      "routes": [
        {
          "name": "RouteView1",
          "pattern": "{tabName}/:layout:",
          "target": [
            "TargetView1"
          ]
        },
      {
          "pattern": "{dispKey}/{aimodel}/DetailDetail/{layout}",
          "name": "DetailDetail",
          "target": [
            "TargetView1",
            "DetailDetail"
          ]
        }
      ],
      "targets": {
        "TargetView1": {
          "id": "listView1",
          "controlAggregation": "beginColumnPages",
          "name": "View1"
        },
        "DetailDetail": {
          "name": "DetailDetail",
          "id": "DetailDetail",
          "controlAggregation": "midColumnPages"
        }
      }
    },
    "rootView": {
      "viewName": "aicockpitfeq.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "aiCockpitQ"
  }
}
